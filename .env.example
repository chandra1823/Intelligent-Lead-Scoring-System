# Copy to .env and edit. Every setting is optional; defaults suit a local install.

# Storage — SQLite by default, point at Postgres for a deployment
# LEAD_API_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/leadscoring

# Encrypts connector credentials at rest. Generate a real one before deploying:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LEAD_API_SECRET_KEY=dev-only-insecure-key-change-me

# Require an API key on every request. Leave false for a single-user local install.
LEAD_API_REQUIRE_API_KEY=false

# Sales capacity and scoring behaviour
# LEAD_API_DECISION_THRESHOLD=0.5
# LEAD_API_SCORE_DECAY_HALF_LIFE_DAYS=21

# Cold-start tier boundaries
# LEAD_API_TIER2_MIN_LABELS=500
# LEAD_API_TIER3_MIN_LABELS=5000
